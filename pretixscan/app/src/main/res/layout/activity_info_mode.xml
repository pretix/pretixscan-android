<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="data"
            type="eu.pretix.pretixscan.droid.ui.info.InfoModeViewDataHolder" />

        <import type="android.view.View" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:title="@string/info_mode_title" />

        </com.google.android.material.appbar.AppBarLayout>

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/pretix_brand_background"
                android:gravity="center"
                android:padding="6dp"
                android:text="@string/info_mode_banner"
                android:textAllCaps="true"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="@color/pretix_brand_dark" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                tools:ignore="all">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/manual_scan_input_for_testing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Ticket secret (Testing only)" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/manual_scan_trigger_for_testing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Scan" />
            </LinearLayout>

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:visibility="@{data.isScanning ? View.VISIBLE : View.GONE}"
                tools:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/result_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardElevation="1dp"
                app:strokeWidth="2dp"
                android:visibility="@{data.hasResult ? View.VISIBLE : View.GONE}"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/result_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        tools:src="@drawable/ic_check_circle_white_24dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/result_status_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{data.resultStatusLabel}"
                            android:textAppearance="?attr/textAppearanceSubtitle1"
                            tools:text="Simuliert: Gültig" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{data.resultAttendeeName}"
                            android:textAppearance="?attr/textAppearanceBody1"
                            tools:text="Max Mustermann" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{data.resultDetails}"
                            android:textAppearance="?attr/textAppearanceCaption"
                            tools:text="Tagesticket · ABCDE" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{data.resultReason}"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:visibility="@{data.hasReason ? View.VISIBLE : View.GONE}"
                            tools:visibility="visible"
                            tools:text="already redeemed" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/info_mode_history_title"
                android:textAppearance="?attr/textAppearanceSubtitle2"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/info_mode_history_empty"
                android:gravity="center"
                android:padding="24dp"
                android:textAppearance="?attr/textAppearanceBody2"
                android:visibility="@{data.historyEmpty ? View.VISIBLE : View.GONE}"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/history_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                tools:listitem="@layout/item_info_scan_history" />

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>